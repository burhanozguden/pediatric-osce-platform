/** Sunucu (Vercel) API istemcisi. Anahtar ve modeller yalnızca sunucuda durur. */
import type { ApiErrorBody, ChatRequestBody, ChatResponseBody, EvaluateRequestBody, EvaluateResponseBody } from '@/types';

function base(): string {
  const b = (window as unknown as { OSCE_API_BASE?: string }).OSCE_API_BASE?.trim().replace(/\/$/, '') ?? '';
  if (!b) throw new Error('Sunucu adresi ayarlanmamış. docs/config.js dosyasına Vercel adresini yazın.');
  return b;
}

async function post<T>(path: string, body: unknown): Promise<T> {
  let res: Response;
  try {
    res = await fetch(`${base()}${path}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
  } catch (err) {
    if (err instanceof Error && err.message.startsWith('Sunucu adresi')) throw err;
    throw new Error('Sunucuya ulaşılamadı. İnternet bağlantınızı kontrol edip yeniden deneyin.');
  }
  let data: unknown = null;
  try {
    data = await res.json();
  } catch {
    /* gövde JSON değil */
  }
  if (!res.ok) {
    const msg = (data as ApiErrorBody | null)?.error;
    throw new Error(msg ?? `İstek başarısız oldu (HTTP ${res.status}).`);
  }
  return data as T;
}

export const chatApi = (body: ChatRequestBody): Promise<ChatResponseBody> => post('/api/chat', body);
export async function evaluateApi(body: EvaluateRequestBody): Promise<EvaluateResponseBody> {
  const res = await post<EvaluateResponseBody>('/api/evaluate', body);
  if (!res?.scorecard) throw new Error('Sunucudan geçerli bir karne gelmedi. Yeniden deneyin.');
  return res;
}
