# --- Sunucu (Vercel) ortam değişkenleri. Bu dosyaya gerçek anahtar YAZMAYIN. ---
# Anthropic API anahtarı: yalnızca sunucuda kalır, tarayıcıya hiç gitmez.
ANTHROPIC_API_KEY=

# Ebeveyn (sohbet) modeli.
ANTHROPIC_MODEL=claude-haiku-5-5

# Karne (değerlendirme) modeli. Boş bırakılırsa ANTHROPIC_MODEL kullanılır.
ANTHROPIC_EVAL_MODEL=claude-sonnet-5-5

# Siteye izin verilen adres(ler); virgülle ayırın. Başka siteler API'yi kullanamaz.
ALLOWED_ORIGINS=https://burhanozguden.github.io

# İsteğe bağlı: bir IP için 10 dakikadaki en çok istek (varsayılan 90).
# RATE_LIMIT_MAX=90
